# Voice providers: browser/edge are the existing defaults; whisper/piper are local.
NEXT_PUBLIC_JARVIS_STT_PROVIDER=whisper
JARVIS_TTS_PROVIDER=piper

# Any OpenAI-compatible local Whisper transcription endpoint.
# For example, a faster-whisper server serving /v1/audio/transcriptions.
WHISPER_API_URL=http://127.0.0.1:9000/v1/audio/transcriptions
WHISPER_MODEL=Systran/faster-distil-whisper-small.en

# Local Piper binary and downloaded .onnx voice model.
PIPER_BIN=/absolute/path/to/.venv/bin/piper
PIPER_MODEL=/absolute/path/to/.piper-voices/en_GB-alan-medium.onnx
